{
  "name": "governtrace-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "prisma:migrate": "npm run prisma:migrate -w server",
    "prisma:seed": "npm run prisma:seed -w server",
    "setup": "node scripts/setup.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "overrides": {
    "pdfjs-dist": "6.2.108"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "tesseract.js@7.0.0": true
  }
}
