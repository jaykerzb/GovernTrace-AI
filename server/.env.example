DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000

# Comma-separated if you need more than one — e.g. local dev plus a
# Cloudflare Tunnel / real domain: "http://localhost:5173,https://your-tunnel.trycloudflare.com"
CLIENT_ORIGIN="http://localhost:5173"

# Defaults to false (plain HTTP) — stated explicitly here rather than left
# unset, since leaving it unset falls back to NODE_ENV === "production"
# (see server/src/lib/auth.ts), which is an easy default to accidentally
# flip by setting NODE_ENV for unrelated reasons. Set to "true" once
# you're reached over a real HTTPS domain (a tunnel, a reverse proxy, a
# real deployment) — browsers increasingly refuse to store a non-Secure
# cookie set from an HTTPS page, which would otherwise break login.
COOKIE_SECURE=false
