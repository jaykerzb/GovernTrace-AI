# Runs governtrace-ai-backup.service once a day. Install alongside the
# .service file:
#   sudo cp deploy/governtrace-ai-backup.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now governtrace-ai-backup.timer
#
# Check it's scheduled with: systemctl list-timers governtrace-ai-backup.timer
# Run it once by hand with:  sudo systemctl start governtrace-ai-backup.service

[Unit]
Description=Daily GovernTrace AI backup

[Timer]
OnCalendar=daily
# Staggers the actual run within a window after the scheduled time instead
# of every install firing at exactly midnight — harmless for a single VM,
# but avoids the habit of assuming OnCalendar times are exact.
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
